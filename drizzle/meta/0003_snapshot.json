      "checkConstraints": {
        "registered_products_id_length": {
          "name": "registered_products_id_length",
          "value": "length(\"registered_products\".\"id\") = 36"
        },
        "registered_products_receipt_hash": {
          "name": "registered_products_receipt_hash",
          "value": "length(\"registered_products\".\"receipt_hash\") = 64 AND \"registered_products\".\"receipt_hash\" NOT GLOB '*[^0-9a-f]*'"
        },
        "registered_products_kind": {
          "name": "registered_products_kind",
          "value": "\"registered_products\".\"kind\" IN ('business', 'individual')"
        },
        "registered_products_contact_length": {
          "name": "registered_products_contact_length",
          "value": "length(\"registered_products\".\"contact_name\") BETWEEN 1 AND 120"
        },
        "registered_products_email_length": {
          "name": "registered_products_email_length",
          "value": "length(\"registered_products\".\"email\") BETWEEN 3 AND 254"
        },
        "registered_products_marketing_choice": {
          "name": "registered_products_marketing_choice",
          "value": "\"registered_products\".\"marketing_consent\" IN (0, 1)"
        },
        "registered_products_business_name": {
          "name": "registered_products_business_name",
          "value": "(\"registered_products\".\"kind\" = 'business' AND \"registered_products\".\"business_name\" IS NOT NULL AND length(\"registered_products\".\"business_name\") BETWEEN 1 AND 120) OR (\"registered_products\".\"kind\" = 'individual' AND \"registered_products\".\"business_name\" IS NULL)"
        },
        "registered_products_marketing_evidence": {
          "name": "registered_products_marketing_evidence",
          "value": "(\"registered_products\".\"marketing_consent\" = 1 AND \"registered_products\".\"marketing_consent_at\" IS NOT NULL AND \"registered_products\".\"marketing_consent_version\" IS NOT NULL) OR (\"registered_products\".\"marketing_consent\" = 0 AND \"registered_products\".\"marketing_consent_at\" IS NULL AND \"registered_products\".\"marketing_consent_version\" IS NULL)"
        }
      }
    }
